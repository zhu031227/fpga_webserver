#===================================================================
# pins.qsf — EP4CE10F17C6 pin assignments (Cyclone IV E, 256-FBGA)
#===================================================================

# --- 50 MHz clock input ---
set_location_assignment PIN_E1 -to clk_50m_in

# --- Reset (active low) ---
set_location_assignment PIN_L12 -to reset_l

# --- UART ---
set_location_assignment PIN_M1 -to uart_rx
set_location_assignment PIN_N1 -to uart_tx

# --- LED ---
set_location_assignment PIN_K15 -to led_o[0]
set_location_assignment PIN_K16 -to led_o[1]
set_location_assignment PIN_K9  -to led_o[2]
set_location_assignment PIN_K10 -to led_o[3]

# --- GMII TX interface ---
set_location_assignment PIN_A3  -to Eth0_GTX_CLK
set_location_assignment PIN_A4  -to Eth0_TXEN
set_location_assignment PIN_A5  -to Eth0_TXER
set_location_assignment PIN_B3  -to Eth0_TXD[0]
set_location_assignment PIN_B4  -to Eth0_TXD[1]
set_location_assignment PIN_B5  -to Eth0_TXD[2]
set_location_assignment PIN_C3  -to Eth0_TXD[3]
set_location_assignment PIN_C4  -to Eth0_TXD[4]
set_location_assignment PIN_C5  -to Eth0_TXD[5]
set_location_assignment PIN_D3  -to Eth0_TXD[6]
set_location_assignment PIN_D4  -to Eth0_TXD[7]

# --- GMII RX interface ---
set_location_assignment PIN_A6  -to Eth0_RXC
set_location_assignment PIN_A7  -to Eth0_RXDV
set_location_assignment PIN_A8  -to Eth0_RXER
set_location_assignment PIN_B6  -to Eth0_RXD[0]
set_location_assignment PIN_B7  -to Eth0_RXD[1]
set_location_assignment PIN_B8  -to Eth0_RXD[2]
set_location_assignment PIN_C6  -to Eth0_RXD[3]
set_location_assignment PIN_C7  -to Eth0_RXD[4]
set_location_assignment PIN_C8  -to Eth0_RXD[5]
set_location_assignment PIN_D6  -to Eth0_RXD[6]
set_location_assignment PIN_D7  -to Eth0_RXD[7]

# --- Ethernet reset ---
set_location_assignment PIN_A9  -to Eth0_GRESET

# --- MDIO ---
set_location_assignment PIN_J12 -to Eth0_MDC
set_location_assignment PIN_J13 -to Eth0_MDIO

#===================================================================
# I/O Standards
#===================================================================

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50m_in
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset_l
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_rx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_tx
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_o[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_o[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_o[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_o[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_GTX_CLK
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXEN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXER
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXD[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXD[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXD[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXD[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXD[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXD[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXD[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_TXD[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXC
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXDV
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXER
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXD[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXD[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXD[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXD[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXD[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXD[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXD[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_RXD[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_GRESET
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_MDC
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to Eth0_MDIO
