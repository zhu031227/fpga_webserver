flowchart TB
    subgraph RISCV_TOP["riscv32_top"]
        CORE["riscv_core\nRV32IC Pipeline"]
        REG_FILE["reg_file\n寄存器堆 32x32"]
        IRAM["instr_ram\n指令RAM"]
        LSU["load_store_unit\n访存单元"]
        BIU["bus_interface\nLCPU总线接口"]
